# Docker Compose Environment Variables
# Copie este arquivo para .env e edite os valores

# ============================================
# NGINX
# ============================================
NGINX_HOST=localhost
NGINX_PORT=8000

# ============================================
# PHP-FPM
# ============================================
PHP_VERSION=latest

# ============================================
# PHPMYADMIN
# ============================================
PHP_MY_ADMIN_PORT=8080

# ============================================
# MYSQL (variáveis legadas - mantidas para compatibilidade)
# ============================================
MYSQL_MAPOS_PORT=8989
MYSQL_MAPOS_VERSION=8.4
MYSQL_MAPOS_HOST=mysql
MYSQL_MAPOS_DATABASE=mapos
MYSQL_MAPOS_ROOT_USER=root
MYSQL_MAPOS_ROOT_PASSWORD=root
MYSQL_MAPOS_USER=mapos
MYSQL_MAPOS_PASSWORD=mapos

# ============================================
# MAP-OS APP (NOVAS - USADAS PELO ENTRYPOINT)
# ============================================

# Banco de dados (DEVEM corresponder às variáveis MYSQL_MAPOS_* acima)
DB_HOSTNAME=mysql
DB_USERNAME=mapos
DB_PASSWORD=mapos
DB_DATABASE=mapos

# URL PÚBLICA DE ACESSO (OBRIGATÓRIO - use a URL exata que acessará no navegador)
# Exemplos:
#   http://localhost:8000/
#   http://192.168.1.202:8081/
#   https://meudominio.com/
APP_BASEURL="http://localhost:8000/"

# ============================================
# ADMIN AUTOMÁTICO (OPCIONAL)
# Se não definir, o firstAccess web será usado
# ============================================
# ADMIN_NAME="Administrador"
# ADMIN_EMAIL="admin@dominio.com"
# ADMIN_PASSWORD="senha_forte_123"

# ============================================
# API (OPCIONAL)
# ============================================
API_ENABLED=false
API_TOKEN_EXPIRE_TIME=3600

# ============================================
# OUTRAS (tem defaults no entrypoint)
# ============================================
# API_JWT_KEY=gerado_automaticamente
# APP_ENCRYPTION_KEY=gerado_automaticamente